---
import Layout from "../layouts/Layout.astro";
// TODO: replace with a real inbox you check before deploying / applying to AdSense.
const CONTACT_EMAIL = "dev.solanki.works@gmail.com";
---

<Layout
  title="Contact — How Rich Is Too Rich"
  description="Get in touch about How Rich Is Too Rich — feedback, press, or takedown requests."
  path="/contact"
>
  <article class="mx-auto max-w-2xl px-6 py-16 text-sm leading-relaxed text-ink/70">
    <h1 class="font-display text-3xl font-bold text-ink">Contact</h1>
    <p class="mt-6">
      Have feedback, found a bug, spotted an outdated net-worth figure, or need to reach us about a
      rights or takedown request? Email:
    </p>
    <p class="mt-3">
      <a href={`mailto:${CONTACT_EMAIL}`} class="font-mono text-amber underline">{CONTACT_EMAIL}</a>
    </p>
    <p class="mt-6 text-ink/50">We aim to respond to legitimate requests within a few business days.</p>
  </article>
</Layout>