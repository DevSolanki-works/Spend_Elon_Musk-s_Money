---
import Layout from '../layouts/Layout.astro';
import { ITEMS, CATEGORY_ORDER } from '../data/items';
import { STARTING_NET_WORTH, ACHIEVEMENTS, formatUsd } from '../lib/gameEngine';

const faqItems = [
  {
    question: "Is this Elon Musk's real, live net worth?",
    answer:
      'No. The starting balance is a single fixed, illustrative figure based on public reporting, updated by hand every few months. This is a satirical game, not a financial data product, and it has no connection to Elon Musk, Tesla, SpaceX, or any other company.',
  },
  {
    question: 'Is this game affiliated with or endorsed by Elon Musk?',
    answer:
      'No. This is an independent, parody simulator for entertainment purposes only. No real company names, logos, or photos are used; every item in the shop is an original, generic description.',
  },
  {
    question: 'Does the game save my progress or collect any data?',
    answer:
      'The game runs entirely in your browser. No purchase data, balances, or personal information are ever sent to a server. A small local high-score record may be stored on your own device only.',
  },
  {
    question: 'What is Doge Mode?',
    answer:
      'Doge Mode is a playful display toggle that converts every price and the running balance into a fictional Dogecoin-style unit at a fixed illustrative rate, purely for fun.',
  },
  {
    question: 'How do the Buy/Sell multipliers work?',
    answer:
      'Switch the quantity toggle between x1, x10, x100, or MAX before hitting Buy or Sell, and every click applies that quantity — MAX buys as many as your balance allows, or sells everything you currently own.',
  },
  {
    question: "What happens when the balance hits zero?",
    answer:
      "You've hit the Zero Balance Achievement — the run is complete. Open the Mission Receipt to see a full breakdown of everything purchased, then reset to fly again.",
  },
];

const title = "Spend Elon Musk's Money — Billionaire Spending Simulator Game";
const description =
  "Spend a satirical $1 trillion mission budget on rockets, mansions, and absurd purchases in this free, 100% client-side billionaire spending simulator. No sign-up, no data collection.";
---

<Layout
  title={title}
  description={description}
  canonicalUrl="https://example.com/"
  faqItems={faqItems}
>
  <!-- ============ STICKY MISSION TELEMETRY HUD ============ -->
  <header
    id="hud"
    class="sticky top-0 z-40 border-b border-cyan-500/30 bg-[#030712]/95 backdrop-blur supports-[backdrop-filter]:bg-[#030712]/80"
  >
    <div class="mx-auto max-w-6xl px-4 py-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button
          id="mission-title"
          type="button"
          class="select-none text-left text-sm font-mono-hud uppercase tracking-widest text-cyan-400/80 hover:text-cyan-300"
          aria-label="Mission title"
        >
          ▲ Mission Control <span class="text-slate-500">/ Spend The Fortune</span>
        </button>

        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-xs font-mono-hud text-slate-400">
            <span>$</span>
            <button
              id="doge-toggle"
              type="button"
              role="switch"
              aria-checked="false"
              class="relative h-6 w-11 rounded-full border border-cyan-500/40 bg-slate-900 transition-colors"
            >
              <span
                id="doge-toggle-knob"
                class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-cyan-400 transition-transform"
              ></span>
            </button>
            <span>Ð</span>
          </label>

          <button
            id="sound-toggle"
            type="button"
            aria-pressed="true"
            class="rounded border border-cyan-500/40 px-2 py-1 text-xs font-mono-hud text-cyan-300 hover:bg-cyan-500/10"
          >
            🔊 SFX ON
          </button>

          <button
            id="open-receipt"
            type="button"
            class="rounded border border-emerald-500/50 px-3 py-1 text-xs font-mono-hud uppercase text-emerald-300 hover:bg-emerald-500/10"
          >
            View Mission Receipt
          </button>
        </div>
      </div>

      <div class="mt-3 grid gap-3 sm:grid-cols-[1fr_auto]">
        <div>
          <div class="flex items-baseline justify-between text-xs font-mono-hud text-slate-400">
            <span>BALANCE</span>
            <span id="balance-percent">100.0000%</span>
          </div>
          <div id="balance" class="font-mono-hud text-3xl font-bold text-emerald-400 sm:text-4xl">
            {formatUsd(STARTING_NET_WORTH)}
          </div>
          <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-900 hud-corners">
            <div
              id="fuel-gauge"
              class="h-full w-full bg-gradient-to-r from-cyan-500 to-emerald-500 transition-[width,background-color] duration-500"
            ></div>
          </div>
          <div class="mt-1 text-[10px] font-mono-hud uppercase tracking-wide text-slate-500">
            Fuel / Funds Remaining
          </div>
        </div>

        <div class="flex items-end gap-1" role="group" aria-label="Quantity multiplier">
          {['x1', 'x10', 'x100', 'MAX'].map((label, i) => (
            <button
              type="button"
              class="multiplier-btn rounded border border-cyan-500/40 px-3 py-1.5 text-xs font-mono-hud text-slate-300 hover:bg-cyan-500/10 aria-pressed:bg-cyan-500/20 aria-pressed:text-cyan-300 aria-pressed:border-cyan-400"
              data-multiplier={label}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 pb-24 pt-8">
    <p class="mb-8 max-w-2xl text-sm text-slate-400">
      Starting mission budget: a flat <strong class="text-slate-200">$1 trillion</strong>,
      an illustrative round-number estimate for entertainment purposes only — not real-time
      financial data, and not linked to any real person's actual net worth.
    </p>

    <!-- ============ ITEM GRID ============ -->
    {CATEGORY_ORDER.map((category) => (
      <section class="mb-10" aria-labelledby={`cat-${category}`}>
        <h2
          id={`cat-${category}`}
          class="mb-3 font-mono-hud text-sm uppercase tracking-widest text-cyan-400/80"
        >
          {category}
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {ITEMS.filter((item) => item.category === category).map((item) => (
            <article
              class="hud-corners rounded-lg border border-slate-800 bg-slate-950/60 p-4"
              data-item-id={item.id}
              data-item-price={item.price}
            >
              <div class="flex items-start justify-between">
                <span class="text-3xl" aria-hidden="true">{item.emoji}</span>
                <span
                  id={`count-${item.id}`}
                  class="rounded-full border border-slate-700 px-2 py-0.5 text-[10px] font-mono-hud text-slate-400"
                >
                  x0
                </span>
              </div>
              <h3 class="mt-2 text-sm font-semibold text-slate-100">{item.name}</h3>
              <p class="mt-1 text-xs text-slate-500">{item.flavor}</p>
              <div id={`price-${item.id}`} class="mt-3 font-mono-hud text-base text-emerald-400">
                {formatUsd(item.price)}
              </div>
              <div class="mt-3 flex gap-2">
                <button
                  type="button"
                  class="buy-btn flex-1 rounded border border-emerald-500/50 py-1.5 text-xs font-mono-hud uppercase text-emerald-300 hover:bg-emerald-500/10 disabled:cursor-not-allowed disabled:opacity-30"
                  data-item-id={item.id}
                >
                  Buy
                </button>
                <button
                  type="button"
                  class="sell-btn flex-1 rounded border border-rose-500/40 py-1.5 text-xs font-mono-hud uppercase text-rose-300 hover:bg-rose-500/10 disabled:cursor-not-allowed disabled:opacity-30"
                  data-item-id={item.id}
                  disabled
                >
                  Sell
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- Secret easter-egg slot, populated only after the title is tapped 5x -->
    <section id="secret-slot" class="mb-10 hidden" aria-live="polite"></section>

    <div class="flex justify-center">
      <button
        id="reset-btn"
        type="button"
        class="rounded border border-slate-700 px-6 py-2 text-xs font-mono-hud uppercase tracking-widest text-slate-400 hover:border-rose-500/50 hover:text-rose-300"
      >
        Reset Mission
      </button>
    </div>

    <!-- ============ SEO CONTENT BLOCK ============ -->
    <article class="prose prose-invert mt-24 max-w-none border-t border-slate-800 pt-12 text-slate-300">
      <h2 class="font-mono-hud text-xl text-slate-100">What Is the Spend Elon Musk's Money Simulator?</h2>
      <p>
        This free browser game hands you a satirical mission budget — a flat, illustrative $1
        trillion — and lets you spend it on everything from a value meal to a national highway
        overhaul until the counter hits zero. It's built as a lighthearted commentary on the
        scale of extreme wealth, not a financial tool or a real-time tracker. Every price, every
        item, and every category is fixed and hand-curated, and nothing here represents any real
        company, product, or individual's actual holdings.
      </p>

      <h2 class="font-mono-hud text-xl text-slate-100">Visualizing $1 Trillion: How Big Is That, Really?</h2>
      <p>
        A trillion dollars is a number most people can say but few can picture. If you spent a
        dollar every second, it would take over 31,000 years to burn through a trillion. This
        game turns that abstraction into something tactile: watch a mission budget drain in real
        time as you buy rockets, mansions, sports franchises, and increasingly absurd purchases,
        and see exactly how far that kind of money actually stretches — and how quickly even a
        trillion dollars can disappear once the big-ticket items start stacking up.
      </p>

      <h2 class="font-mono-hud text-xl text-slate-100">How to Play &amp; Strategy Guide</h2>
      <p>
        Pick a quantity multiplier — x1, x10, x100, or MAX — then hit Buy on any item in the
        shop grid. Your balance and the Fuel Gauge update instantly, and an achievement toast
        fires the first time you cross a major spending milestone. Sell an item back at any point
        if you change your mind. Toggle Doge Mode to see every price converted into a playful
        fictional currency, and switch on the sound effects for a synthesized click-and-launch
        feedback loop. When you're done, open the Mission Receipt to get a shareable, terminal-
        style summary of your entire run.
      </p>

      <h2 class="font-mono-hud text-xl text-slate-100">Frequently Asked Questions</h2>
      <div class="not-prose divide-y divide-slate-800 rounded-lg border border-slate-800">
        {faqItems.map((faq) => (
          <details class="group p-4">
            <summary class="cursor-pointer list-none font-mono-hud text-sm text-slate-100 marker:content-none">
              <span class="mr-2 text-cyan-400 group-open:hidden">+</span>
              <span class="mr-2 hidden text-cyan-400 group-open:inline">−</span>
              {faq.question}
            </summary>
            <p class="mt-2 pl-5 text-sm text-slate-400">{faq.answer}</p>
          </details>
        ))}
      </div>

      <p class="mt-8 text-xs text-slate-600">
        Not affiliated with, endorsed by, or sponsored by any real individual or company. Net
        worth figures are illustrative, publicly-sourced estimates used for entertainment
        purposes only. See the <a href="/disclaimer" class="underline">disclaimer</a> for full details.
      </p>
    </article>
  </main>

  <!-- ============ ACHIEVEMENT TOAST CONTAINER ============ -->
  <div
    id="toast-container"
    class="pointer-events-none fixed bottom-4 left-1/2 z-50 flex w-full max-w-sm -translate-x-1/2 flex-col gap-2 px-4"
    aria-live="polite"
  ></div>

  <!-- ============ MISSION RECEIPT MODAL ============ -->
  <dialog
    id="receipt-modal"
    class="w-full max-w-md rounded-lg border border-cyan-500/30 bg-slate-950 p-0 text-slate-100 backdrop:bg-black/70"
  >
    <div class="hud-corners p-5">
      <div class="flex items-center justify-between">
        <h2 class="font-mono-hud text-sm uppercase tracking-widest text-cyan-400">Mission Receipt</h2>
        <button id="close-receipt" type="button" class="text-slate-500 hover:text-slate-200" aria-label="Close">✕</button>
      </div>
      <pre id="receipt-text" class="mt-4 max-h-80 overflow-y-auto whitespace-pre-wrap font-mono-hud text-xs text-slate-300"></pre>
      <div class="mt-4 flex gap-2">
        <button
          id="copy-receipt"
          type="button"
          class="flex-1 rounded border border-emerald-500/50 py-2 text-xs font-mono-hud uppercase text-emerald-300 hover:bg-emerald-500/10"
        >
          Copy Receipt to Clipboard
        </button>
      </div>
    </div>
  </dialog>

  <script>
    import { ITEMS } from '../data/items';
    import {
      createInitialState,
      purchase,
      sell,
      reset as resetState,
      percentSpent,
      percentRemaining,
      canAfford,
      checkNewAchievements,
      withUnlockedAchievements,
      buildSecretItem,
      formatUsd,
      formatDoge,
      amountSpent,
      type GameState,
      type ShopItem,
    } from '../lib/gameEngine';

    const itemsById = new Map<string, ShopItem>(ITEMS.map((i) => [i.id, i]));
    let state: GameState = createInitialState();
    let multiplier: number | 'MAX' = 1;
    let dogeMode = false;
    let soundOn = true;
    let titleTapTimes: number[] = [];

    // ---------- Web Audio (synthesized, no external files) ----------
    let audioCtx: AudioContext | null = null;
    function getAudioCtx(): AudioContext | null {
      if (!soundOn) return null;
      if (!audioCtx) {
        const Ctx = window.AudioContext || (window as any).webkitAudioContext;
        if (!Ctx) return null;
        audioCtx = new Ctx();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function tone(freq: number, duration: number, type: OscillatorType = 'sine', gainPeak = 0.15) {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(gainPeak, ctx.currentTime + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration);
    }

    function playClick() {
      tone(880, 0.08, 'square', 0.08);
    }
    function playCoinChime() {
      tone(1200, 0.12, 'triangle', 0.12);
      setTimeout(() => tone(1600, 0.15, 'triangle', 0.1), 60);
    }
    function playLaunchRumble() {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(60, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 1.2);
      gain.gain.setValueAtTime(0.2, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.2);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 1.2);
    }

    // ---------- Rendering ----------
    const balanceEl = document.getElementById('balance')!;
    const balancePercentEl = document.getElementById('balance-percent')!;
    const fuelGaugeEl = document.getElementById('fuel-gauge')!;
    const secretSlot = document.getElementById('secret-slot')!;

    function fmt(usd: number): string {
      return dogeMode ? formatDoge(usd) : formatUsd(usd);
    }

    function render() {
      balanceEl.textContent = fmt(state.balance);
      const remaining = percentRemaining(state);
      balancePercentEl.textContent = `${remaining.toFixed(4)}%`;
      fuelGaugeEl.style.width = `${Math.max(remaining, 0)}%`;

      fuelGaugeEl.classList.remove(
        'from-cyan-500', 'to-emerald-500', 'from-orange-500', 'to-rose-500'
      );
      if (remaining < 20) {
        fuelGaugeEl.classList.add('from-orange-500', 'to-rose-500');
        balanceEl.classList.remove('text-emerald-400');
        balanceEl.classList.add('text-orange-400');
      } else {
        fuelGaugeEl.classList.add('from-cyan-500', 'to-emerald-500');
        balanceEl.classList.remove('text-orange-400');
        balanceEl.classList.add('text-emerald-400');
      }

      for (const item of ITEMS) {
        const priceEl = document.getElementById(`price-${item.id}`);
        const countEl = document.getElementById(`count-${item.id}`);
        const card = document.querySelector(`[data-item-id="${item.id}"]`) as HTMLElement | null;
        if (priceEl) priceEl.textContent = fmt(item.price);
        const owned = state.counts[item.id] ?? 0;
        if (countEl) countEl.textContent = `x${owned}`;
        if (card) {
          const buyBtn = card.querySelector('.buy-btn') as HTMLButtonElement | null;
          const sellBtn = card.querySelector('.sell-btn') as HTMLButtonElement | null;
          const qty = resolveQty(item, 'buy');
          if (buyBtn) buyBtn.disabled = !canAfford(state, item, qty);
          if (sellBtn) sellBtn.disabled = owned <= 0;
        }
      }

      renderSecretSlot();
    }

    function resolveQty(item: ShopItem, action: 'buy' | 'sell'): number {
      if (multiplier === 'MAX') {
        if (action === 'buy') {
          return item.price > 0 ? Math.floor(state.balance / item.price) : 0;
        }
        return state.counts[item.id] ?? 0;
      }
      return multiplier;
    }

    function renderSecretSlot() {
      if (!state.secretRevealed) {
        secretSlot.classList.add('hidden');
        secretSlot.innerHTML = '';
        return;
      }
      secretSlot.classList.remove('hidden');
      const secret = buildSecretItem(state);
      const owned = state.secretPurchased ? 1 : 0;
      secretSlot.innerHTML = `
        <h2 class="mb-3 font-mono-hud text-sm uppercase tracking-widest text-rose-400">Classified</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class="hud-corners rounded-lg border border-rose-500/40 bg-slate-950/60 p-4">
            <div class="flex items-start justify-between">
              <span class="text-3xl">${secret.emoji}</span>
              <span class="rounded-full border border-rose-700 px-2 py-0.5 text-[10px] font-mono-hud text-rose-400">x${owned}</span>
            </div>
            <h3 class="mt-2 text-sm font-semibold text-slate-100">${secret.name}</h3>
            <p class="mt-1 text-xs text-slate-500">${secret.flavor}</p>
            <div class="mt-3 font-mono-hud text-base text-rose-400">${fmt(secret.price)}</div>
            <button id="secret-buy" type="button" class="mt-3 w-full rounded border border-rose-500/50 py-1.5 text-xs font-mono-hud uppercase text-rose-300 hover:bg-rose-500/10 disabled:cursor-not-allowed disabled:opacity-30" ${state.secretPurchased ? 'disabled' : ''}>
              ${state.secretPurchased ? 'Deployed' : 'Buy'}
            </button>
          </article>
        </div>
      `;
      document.getElementById('secret-buy')?.addEventListener('click', () => {
        const fresh = buildSecretItem(state);
        state = purchase(state, fresh, 1);
        playLaunchRumble();
        afterStateChange();
      });
    }

    // ---------- Achievements ----------
    function afterStateChange() {
      const newly = checkNewAchievements(state);
      state = withUnlockedAchievements(state, newly);
      for (const a of newly) showToast(`${a.emoji} ${a.label}`);
      render();
    }

    function showToast(message: string) {
      const container = document.getElementById('toast-container')!;
      const toast = document.createElement('div');
      toast.className =
        'pointer-events-auto animate-[fadeIn_0.2s_ease-out] rounded border border-emerald-500/50 bg-slate-950/95 px-4 py-2 text-center font-mono-hud text-xs text-emerald-300 shadow-lg';
      toast.textContent = `ACHIEVEMENT UNLOCKED: ${message}`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.transition = 'opacity 0.4s ease';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }, 3200);
    }

    // ---------- Event wiring ----------
    document.getElementById('mission-title')?.addEventListener('click', () => {
      const now = Date.now();
      titleTapTimes = [...titleTapTimes.filter((t) => now - t < 2000), now];
      if (titleTapTimes.length >= 5 && !state.secretRevealed) {
        state = { ...state, secretRevealed: true };
        titleTapTimes = [];
        render();
      }
    });

    document.querySelectorAll('.multiplier-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-multiplier')!;
        multiplier = val === 'MAX' ? 'MAX' : (parseInt(val.replace('x', ''), 10) as number);
        document.querySelectorAll('.multiplier-btn').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        render();
      });
    });

    document.querySelectorAll('.buy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-item-id')!;
        const item = itemsById.get(id);
        if (!item) return;
        const qty = resolveQty(item, 'buy');
        if (qty <= 0) return;
        const before = amountSpent(state);
        state = purchase(state, item, qty);
        if (before !== amountSpent(state)) {
          item.price >= 1_000_000_000 ? playLaunchRumble() : playCoinChime();
        }
        afterStateChange();
      });
    });

    document.querySelectorAll('.sell-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-item-id')!;
        const item = itemsById.get(id);
        if (!item) return;
        const qty = resolveQty(item, 'sell');
        if (qty <= 0) return;
        state = sell(state, item, qty);
        playClick();
        render();
      });
    });

    document.getElementById('doge-toggle')?.addEventListener('click', () => {
      dogeMode = !dogeMode;
      const btn = document.getElementById('doge-toggle')!;
      const knob = document.getElementById('doge-toggle-knob')!;
      btn.setAttribute('aria-checked', String(dogeMode));
      knob.style.transform = dogeMode ? 'translateX(20px)' : 'translateX(0)';
      playClick();
      render();
    });

    document.getElementById('sound-toggle')?.addEventListener('click', () => {
      soundOn = !soundOn;
      const btn = document.getElementById('sound-toggle') as HTMLButtonElement;
      btn.setAttribute('aria-pressed', String(soundOn));
      btn.textContent = soundOn ? '🔊 SFX ON' : '🔇 SFX OFF';
      if (soundOn) playClick();
    });

    document.getElementById('reset-btn')?.addEventListener('click', () => {
      state = resetState();
      playClick();
      render();
    });

    // ---------- Receipt modal ----------
    const modal = document.getElementById('receipt-modal') as HTMLDialogElement;
    document.getElementById('open-receipt')?.addEventListener('click', () => {
      renderReceipt();
      modal.showModal();
      playClick();
    });
    document.getElementById('close-receipt')?.addEventListener('click', () => modal.close());

    function renderReceipt() {
      const lines: string[] = [];
      lines.push('=== MISSION RECEIPT ===');
      lines.push('');
      if (state.log.length === 0) {
        lines.push('No purchases yet.');
      } else {
        const totals = new Map<string, { name: string; qty: number; total: number }>();
        for (const entry of state.log) {
          const existing = totals.get(entry.itemId);
          if (existing) {
            existing.qty += entry.qty;
            existing.total += entry.total;
          } else {
            totals.set(entry.itemId, { name: entry.name, qty: entry.qty, total: entry.total });
          }
        }
        for (const t of totals.values()) {
          lines.push(`${t.qty}x ${t.name} ....... ${fmt(t.total)}`);
        }
      }
      lines.push('');
      lines.push(`SPENT:     ${fmt(amountSpent(state))} (${percentSpent(state).toFixed(4)}%)`);
      lines.push(`REMAINING: ${fmt(state.balance)}`);
      lines.push('');
      lines.push('Try it yourself \u2014 spend the fortune.');
      const text = lines.join('\n');
      const receiptEl = document.getElementById('receipt-text')!;
      receiptEl.textContent = text;
      receiptEl.dataset.raw = text;
    }

    document.getElementById('copy-receipt')?.addEventListener('click', async () => {
      const raw = document.getElementById('receipt-text')!.dataset.raw ?? '';
      try {
        await navigator.clipboard.writeText(raw);
        const btn = document.getElementById('copy-receipt')!;
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = original), 1500);
      } catch {
        // Clipboard API unavailable — receipt text remains selectable in the <pre>.
      }
    });

    render();
  </script>
</Layout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>