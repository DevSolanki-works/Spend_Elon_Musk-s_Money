---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="500 — Something Went Wrong | How Rich Is Too Rich"
  description="Something went wrong on our end."
  path="/500"
>
  <section class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
    <div class="brutal bg-paper px-8 py-6 text-ink" style="--accent:#FFC630">
      <p class="font-mono text-xs font-bold uppercase tracking-widest text-debit">Register jammed</p>
      <p class="mt-2 font-display text-2xl font-black">500 — Something broke</p>
    </div>
    <p class="mt-6 text-sm text-ink/70">
      Something went wrong on our end, not yours. Try refreshing in a moment.
    </p>
    <a href="/" class="brutal mt-6 rounded-md border-2 border-line bg-amber px-5 py-2 font-display text-sm font-bold text-ink">
      Back to the game
    </a>
  </section>
</Layout>