---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  // Either works: pass `path` (e.g. "/disclaimer") and canonical is built from
  // astro.config.mjs's `site`, or pass a full `canonicalUrl` to override.
  path?: string;
  canonicalUrl?: string;
  ogImage?: string;
  faqItems?: FaqItem[];
}

const {
  title,
  description,
  path = '/',
  canonicalUrl,
  ogImage = '/og-image.png',
  faqItems = [],
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://how-rich-is-too-rich.com/');
const resolvedCanonical = canonicalUrl ?? new URL(path, siteBase).toString();

const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.answer,
          },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={resolvedCanonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      faqSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#ffc630" />
  </head>
  <body class="bg-void text-ink antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  /*
    DESIGN SYSTEM — "Carnival Poster"
    Bright, warm, comic-book — a fun toy, not a financial dashboard. Flat color,
    thick black borders, hard offset "sticker" shadows. No gradients, no glow,
    no glassmorphism.
  */
  @theme {
    --font-display: "Space Grotesk", system-ui, sans-serif;
    --font-body: "Inter", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;

    --color-void: #fffbf2;
    --color-void-raised: #ffffff;
    --color-paper: #fff4de;
    --color-ink: #1a1508;
    --color-line: #1a1508;
    --color-line-paper: #e3b95c;
    --color-amber: #ffc630;
    --color-credit: #16a34a;
    --color-debit: #e11d3c;
    --color-pop-pink: #e0328b;

    --color-cat-vehicles: #3fa9f5;
    --color-cat-real-estate: #2fe3b4;
    --color-cat-companies: #b388ff;
    --color-cat-space: #7c83fd;
    --color-cat-absurd: #ff3d8f;
  }

  html {
    color-scheme: light;
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-void);
    background-image: radial-gradient(circle at 1px 1px, rgba(26, 21, 8, 0.06) 1.5px, transparent 0);
    background-size: 24px 24px;
    font-family: var(--font-body);
  }

  .font-mono-hud {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* Hard "sticker" offset shadow — flat, no blur. Color set via --accent. */
  .brutal {
    --accent: var(--color-ink);
    box-shadow: 4px 4px 0 var(--accent);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .brutal:hover {
    transform: translate(-2px, -2px) rotate(-0.6deg);
    box-shadow: 6px 6px 0 var(--accent);
  }
  .brutal:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--accent);
  }

  .ticket-stub {
    background: var(--color-amber);
    color: var(--color-ink);
    transform: rotate(-2deg);
    box-shadow: 2px 2px 0 rgba(26, 21, 8, 0.5);
  }

  .sticker {
    display: inline-block;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 var(--color-ink);
  }
  .sticker:nth-of-type(even) {
    transform: rotate(2.5deg);
  }

  .perforated-edge {
    --hole: 10px;
    height: var(--hole);
    background-image: radial-gradient(
      circle,
      var(--color-void) calc(var(--hole) / 2 - 1px),
      transparent calc(var(--hole) / 2)
    );
    background-size: calc(var(--hole) * 1.6) 100%;
    background-position: center;
  }

  @keyframes bump {
    0% { transform: scale(1); }
    35% { transform: scale(1.14) rotate(-1deg); }
    100% { transform: scale(1); }
  }
  .animate-bump { animation: bump 320ms cubic-bezier(0.34, 1.56, 0.64, 1); }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px) rotate(-0.5deg); }
    40% { transform: translateX(5px) rotate(0.5deg); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(3px); }
  }
  .animate-shake { animation: shake 420ms ease-in-out; }

  @keyframes wobble-in {
    0% { opacity: 0; transform: scale(0.85) rotate(-4deg); }
    60% { opacity: 1; transform: scale(1.05) rotate(2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }
  .animate-wobble-in { animation: wobble-in 380ms ease-out; }

  @keyframes toast-in {
    from { opacity: 0; transform: translate(-50%, 10px) rotate(-2deg); }
    to { opacity: 1; transform: translate(-50%, 0) rotate(-2deg); }
  }
  .animate-toast-in { animation: toast-in 200ms ease-out; }

  @keyframes chaos-hue {
    from { filter: hue-rotate(0deg) saturate(1.4); }
    to { filter: hue-rotate(360deg) saturate(1.4); }
  }
  body.chaos-mode {
    animation: chaos-hue 1.2s linear infinite;
  }
  body.chaos-mode .brutal {
    animation: bump 600ms ease-in-out infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>