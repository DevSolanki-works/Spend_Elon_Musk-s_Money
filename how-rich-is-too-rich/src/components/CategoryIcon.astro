---
interface Props {
  category: "vehicles" | "real-estate" | "companies" | "space" | "absurd";
  class?: string;
}
const { category, class: className = "" } = Astro.props;
const common = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
---

{category === "vehicles" && (
  <svg viewBox="0 0 24 24" class={className} set:html={`<path ${common} d="M3 16h1.2l1-4.5A2 2 0 0 1 7.1 10h9.8a2 2 0 0 1 1.9 1.5l1 4.5H21"/><rect ${common} x="3" y="16" width="18" height="3" rx="1"/><circle ${common} cx="7.5" cy="19.5" r="1.5"/><circle ${common} cx="16.5" cy="19.5" r="1.5"/>`} />
)}

{category === "real-estate" && (
  <svg viewBox="0 0 24 24" class={className} set:html={`<path ${common} d="M4 11.5 12 4l8 7.5"/><path ${common} d="M6 10v9.5h12V10"/><rect ${common} x="10" y="14" width="4" height="5.5"/>`} />
)}

{category === "companies" && (
  <svg viewBox="0 0 24 24" class={className} set:html={`<rect ${common} x="3" y="8" width="18" height="11" rx="1.5"/><path ${common} d="M8.5 8V6.5A1.5 1.5 0 0 1 10 5h4a1.5 1.5 0 0 1 1.5 1.5V8"/><line ${common} x1="3" y1="13" x2="21" y2="13"/>`} />
)}

{category === "space" && (
  <svg viewBox="0 0 24 24" class={className} set:html={`<path ${common} d="M12 3c2.5 2 3.8 5.3 3.8 8.7 0 2-.5 3.7-1.3 5.3h-5c-.8-1.6-1.3-3.3-1.3-5.3C8.2 8.3 9.5 5 12 3Z"/><circle ${common} cx="12" cy="10.5" r="1.6"/><path ${common} d="M8.5 15.5 6 20l3-1.2M15.5 15.5 18 20l-3-1.2"/>`} />
)}

{category === "absurd" && (
  <svg viewBox="0 0 24 24" class={className} set:html={`<path ${common} d="M12 3.5 13.9 9.3 20 9.7l-4.8 3.8L16.9 20 12 16.4 7.1 20l1.7-6.5L4 9.7l6.1-.4Z"/>`} />
)}
